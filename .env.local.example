# ==============================================
# SAGE GLOBAL ADVISORY - Environment Variables
# ==============================================
# Copy to .env.local for local development. Set the same values in
# Vercel → Project → Settings → Environment Variables (Production + Preview).
# NOTE: these are read at BUILD time too — redeploy after changing them.

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://sageglobaladvisory.com
# Set to true only once sageglobaladvisory.com resolves to Vercel: 308-redirects the old domains to it.
REDIRECT_LEGACY_DOMAINS=false

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key        # server only, never expose
POSTGRES_URL_NON_POOLING=postgres://...                 # only needed for `npm run cms:migrate`

# --- CMS (AI website editor at /admin) ---
CMS_SESSION_SECRET=generate-with-openssl-rand-base64-48 # 32+ chars; rotating it signs everyone out
CMS_ADMIN_EMAILS=admin@sagetaxconsultancy.com           # comma-separated Supabase Auth users allowed into /admin
OPENAI_API_KEY=sk-...
CMS_TEXT_MODEL=gpt-6-luna
CMS_IMAGE_MODEL=gpt-image-2.5-flare-2026-09-08
CMS_IMAGE_QUALITY=high

# --- Optional ---
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX     # Google Analytics 4 — loads only after visitor consent
GOOGLE_SITE_VERIFICATION=
GNEWS_API_KEY=
NEWSAPI_API_KEY=
REVALIDATION_SECRET=
